# Server-only. Copy to Wisp/.env; never expose keys through VITE_* variables.
# Alternatively set WISP_ENV_FILE to an existing server-side .env file.
# Process environment values override file values. Restart API after changes.
GEMINI_API_KEY=
# GOOGLE_API_KEY is accepted when GEMINI_API_KEY is not set.
# Required: use a model available to your own Gemini account (no implicit default).
GEMINI_MODEL=
GEMINI_API_VERSION=v1beta
# Total deadline, > 0 and <= 180 seconds.
GEMINI_TIMEOUT_SECONDS=110
